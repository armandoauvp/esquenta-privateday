{
  // Sala da pista: um Worker na frente e um Durable Object (SQLite, disponível no plano
  // gratuito) com toda a pista. Detalhes em servidor/README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esquenta-pista",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "PISTA", "class_name": "Pista" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Pista"] }],
  "observability": { "enabled": true },
  // GOOGLE_CLIENT_ID: "Entrar com Google" da organização (docs/deploy.md); vazio = sem login.
  // ORIGENS: domínios aceitos, separados por vírgula; vazio = qualquer um.
  // Secrets (wrangler secret put): SEGREDO, ADMIN_CHAVE, ADMINS.
  "vars": { "GOOGLE_CLIENT_ID": "593681368158-pg7ihv8nna3v6qb9hasso1rp3vnlf7nv.apps.googleusercontent.com", "ORIGENS": "" }
}
